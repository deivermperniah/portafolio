---
import SectionHeader from "./SectionHeader.astro";
import { profile, ui, anchors, tr, type Lang } from "../data/profile";
import { hasPublicFile } from "../data/assets";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const hasPhoto = hasPublicFile(profile.photo);
---

<section id={anchors.about} class="section">
  <div class="container stack-lg">
    <SectionHeader index={1} label={t.sections.about} title={t.about.title} />
    <div class="about">
      {
        hasPhoto ? (
          <div class="avatar avatar-frame">
            <img src={profile.photo} alt={`${t.about.photo} ${profile.name}`} width="200" height="200" />
          </div>
        ) : (
          <div class="avatar avatar-fallback" aria-hidden="true">DP</div>
        )
      }
      <div class="about-text">
        {profile.about.map((p) => <p>{tr(p, lang)}</p>)}
      </div>
    </div>
  </div>
</section>
