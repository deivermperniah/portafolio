---
import CommandInput from "./CommandInput.astro";
---

<div class="terminal-container">
  <div class="terminal-header">
    <div class="window-controls">
      <div class="control-dot dot-close"></div>
      <div class="control-dot dot-min"></div>
      <div class="control-dot dot-max"></div>
    </div>
    <div class="window-title">deivermperniah@portfolio:~</div>
    <div style="width: 52px;"></div>
    <!-- Spacer to center title -->
  </div>

  <div class="terminal-window" id="terminal-window">
    <div id="terminal-output"></div>
    <div id="current-input-row" style="display: none;">
      <CommandInput />
    </div>
  </div>
</div>

<script>
  const terminalOutput = document.getElementById("terminal-output")!;
  const terminalWindow = document.getElementById("terminal-window")!;
  const terminalInput = document.getElementById(
    "terminal-input",
  ) as HTMLInputElement;
  const bootMessage = document.getElementById("boot-message")!;

  const COMMANDS = {
    HELP: "help",
    ABOUT: "about",
    SKILLS: "skills",
    EXPERIENCE: "experience",
    PROJECTS: "projects",
    CONTACT: "contact",
    TOOLS: "tools",
    LANGUAGES: "languages",
    CLEAR: "clear",
    LS: "ls",
    NAME: "name",
    PROFESSION: "profession",
    LOCATION: "location",
    EDUCATION: "education",
  };

  const DATA = {
    about: `¡Hola! Soy Deiver Pernia un Informático con 1 año de experiencia. Mis conocimientos abarcan: Frontend, Backend, Bases de Datos, Sistemas Operativos y Soporte Técnico.

Actualmente, me encuentro ampliando mis habilidades mientras curso Ingeniería en Informática. En mi tiempo libre, desarrollo proyectos personales e ideas innovadoras para seguir creciendo profesionalmente.`,
    skills: `Frontend: HTML | CSS | JavaScript | Vue
Backend: Laravel | Supabase
Bases de Datos: MySQL | PostgreSQL
Sistemas Operativos: Linux | Windows
Soporte Técnico: Software | Hardware | Redes`,
    experience: `Técnico de Soporte Informático – Instituto Universitario Adventista de Venezuela
<i style="color: var(--text-gray); opacity: 0.8;">Agosto 2023 – Diciembre 2023</i>
<span class="hanging-list">- Brindé soporte técnico a usuarios, resolviendo incidencias de software y hardware, realizando diagnóstico y reparación de equipos, así como la instalación y configuración de sistemas operativos y aplicaciones.</span><span class="hanging-list">- Ejecuté mantenimiento preventivo y correctivo de redes, incluyendo la configuración y reparación de routers, switches y cableado estructurado, solucionando problemas de conectividad y reduciendo el tiempo de inactividad de la infraestructura.</span>
Desarrollador Frontend (Pasantías) – Redmasiva
<i style="color: var(--text-gray); opacity: 0.8;">Febrero 2024 – Junio 2024</i>
<span class="hanging-list">- Participé en el desarrollo frontend de proyectos como Biblia.chat, Redmasiva AI y B1omed, utilizando HTML, CSS, JavaScript y Vue.js, implementando funcionalidades interactivas y optimizando el rendimiento y la experiencia de usuario.</span>
Técnico de Soporte Informático & Frontend – Alimentos Venepan
<i style="color: var(--text-gray); opacity: 0.8;">Julio 2024 – Octubre de 2024</i>
<span class="hanging-list">- Resolví incidencias de software y hardware para usuarios finales, realizando instalación, configuración y actualización de sistemas operativos y aplicaciones, así como la reparación de equipos y documentación de soluciones.</span><span class="hanging-list">- Administré y mantuve la infraestructura de redes LAN/WAN, configurando routers, switches y firewalls, resolviendo problemas de conectividad, aplicando medidas de seguridad y monitoreando el rendimiento de la red.</span><span class="hanging-list">- Gestioné bases de datos MySQL y sistemas administrativos (ERP), asegurando la integridad, disponibilidad y respaldo de la información mediante copias de seguridad y optimización del rendimiento.</span><span class="hanging-list">- Desarrollé y mantuve la intranet corporativa, implementando funcionalidades para mejorar la comunicación interna y el acceso a la información, utilizando HTML, CSS, JavaScript y Vue.js.</span>`,
    projects: [
      {
        name: "Biblia.chat",
        repo: "github.com/deivermpernia/biblia-chat",
        link: "biblia.chat",
      },
      {
        name: "EcoTrack",
        repo: "github.com/deivermpernia/ecotrack",
        link: "ecotrack.dev",
      },
      {
        name: "DevFlow",
        repo: "github.com/deivermpernia/devflow",
        link: "devflow.io",
      },
    ],
    contact: `Email: <a href="mailto:deivermph@gmail.com" class="project-link">deivermperniah@gmail.com</a>
Teléfono: +51 927 494 171`,
    tools: `Figma | Git | GitHub`,
    languages: `🇪🇸 Español - Nativo
🇺🇸 Inglés - A2`,
    education: `Técnico Superior Universitario en Informática
<i style="color: var(--text-gray); opacity: 0.8;">Enero de 2021 - Junio de 2024</i>
Instituto Universitario Adventista de Venezuela

Ingeniería en Informática
<i style="color: var(--text-gray); opacity: 0.8;">Octubre de 2024 - Presente</i>
Universidad Politécnica Territorial de Yaracuy “Arístides Bastidas”`,
  };

  const commandHistory: string[] = [];
  let historyIndex = -1;

  async function typeText(text: string, element: HTMLElement, speed = 20) {
    return new Promise((resolve) => {
      let i = 0;
      const interval = setInterval(() => {
        if (i < text.length) {
          element.textContent += text.charAt(i);
          i++;
          terminalWindow.scrollTop = terminalWindow.scrollHeight;
        } else {
          clearInterval(interval);
          resolve(true);
        }
      }, speed);
    });
  }

  function createOutputBlock(command: string, content: string | HTMLElement) {
    const block = document.createElement("div");
    block.className = "output-block";

    const promptLine = document.createElement("div");
    promptLine.className = "command-input-container";
    promptLine.innerHTML = `
      <span class="prompt">
        <span class="prompt-user">deivermperniah</span>@<span class="prompt-host"
          >portfolio</span
        >:~$
      </span>
      <span style="color: var(--text-white);">${command}</span>
    `;

    const outputLine = document.createElement("div");
    outputLine.className = "command-output";

    if (typeof content === "string") {
      outputLine.innerHTML = content;
    } else {
      outputLine.appendChild(content);
    }

    block.appendChild(promptLine);
    block.appendChild(outputLine);
    terminalOutput.appendChild(block);
    terminalWindow.scrollTop = terminalWindow.scrollHeight;
  }

  async function handleCommand(commandLine: string) {
    const fullCommand = commandLine.trim();
    if (!fullCommand) return;

    const [command, ...args] = fullCommand.toLowerCase().split(" ");

    switch (command) {
      case COMMANDS.HELP:
        const helpText = `Available commands:
  help        - Show this list of commands
  clear       - Clean the screen and restart presentation
  ls          - List the main sections of the portfolio
  about       - A brief description about who I am
  contact     - My email
  languages   - Languages I speak
  skills      - List of my technical knowledge
  tools       - Tools I use daily
  experience  - My detailed professional background
  projects    - Some of the projects I've worked on
  education   - My academic background
  name        - Show my full name
  profession  - Show my primary role
  location    - My current location`;
        createOutputBlock(fullCommand, helpText);
        break;

      case COMMANDS.ABOUT:
        createOutputBlock(fullCommand, DATA.about);
        break;

      case COMMANDS.SKILLS:
        createOutputBlock(fullCommand, DATA.skills);
        break;

      case COMMANDS.EXPERIENCE:
        createOutputBlock(fullCommand, DATA.experience);
        break;

      case COMMANDS.PROJECTS:
        const projectsContainer = document.createElement("div");
        DATA.projects.forEach((p) => {
          const item = document.createElement("div");
          item.style.marginBottom = "4px";
          item.innerHTML = `- <span style="display:inline-block; min-width: 100px; color: var(--text-gray);">${p.name}</span> | <a href="https://${p.repo}" target="_blank" class="project-link">repositorio</a> | <a href="https://${p.link}" target="_blank" class="project-link">link</a>`;
          projectsContainer.appendChild(item);
        });
        createOutputBlock(fullCommand, projectsContainer);
        break;

      case COMMANDS.CONTACT:
        createOutputBlock(fullCommand, DATA.contact);
        break;

      case COMMANDS.TOOLS:
        createOutputBlock(fullCommand, DATA.tools);
        break;

      case COMMANDS.LANGUAGES:
        createOutputBlock(fullCommand, DATA.languages);
        break;

      case COMMANDS.EDUCATION:
        createOutputBlock(fullCommand, DATA.education);
        break;

      case COMMANDS.CLEAR:
        terminalOutput.innerHTML = "";
        startSequence();
        break;

      case COMMANDS.LS:
        const lsOutput = document.createElement("div");
        lsOutput.style.display = "grid";
        lsOutput.style.gridTemplateColumns =
          "repeat(auto-fill, minmax(130px, 1fr))";
        lsOutput.style.gap = "10px";
        lsOutput.style.color = "#3584e4"; // Fedora/GNOME directory blue
        lsOutput.style.fontWeight = "bold";
        lsOutput.innerHTML = `
          <span class="ls-item" style="cursor: pointer;">about</span>
          <span class="ls-item" style="cursor: pointer;">contact</span>
          <span class="ls-item" style="cursor: pointer;">languages</span>
          <span class="ls-item" style="cursor: pointer;">skills</span>
          <span class="ls-item" style="cursor: pointer;">tools</span>
          <span class="ls-item" style="cursor: pointer;">experience</span>
          <span class="ls-item" style="cursor: pointer;">projects</span>
          <span class="ls-item" style="cursor: pointer;">education</span>
        `;
        createOutputBlock(fullCommand, lsOutput);
        break;

      case COMMANDS.NAME:
        createOutputBlock(fullCommand, "Deiver Pernia");
        break;

      case COMMANDS.PROFESSION:
        createOutputBlock(fullCommand, "Full Stack Developer & IT Support");
        break;

      case COMMANDS.LOCATION:
        createOutputBlock(fullCommand, "Lima, Perú");
        break;

      default:
        createOutputBlock(
          fullCommand,
          `bash: ${command}: instrucción no encontrada...`,
        );
    }
  }

  terminalInput.addEventListener("keydown", (e) => {
    if (e.key === "Enter") {
      const command = terminalInput.value;
      if (command.trim()) {
        commandHistory.push(command);
        historyIndex = commandHistory.length;
      }
      handleCommand(command);
      terminalInput.value = "";
    } else if (e.key === "ArrowUp") {
      if (historyIndex > 0) {
        historyIndex--;
        terminalInput.value = commandHistory[historyIndex];
      }
      e.preventDefault();
    } else if (e.key === "ArrowDown") {
      if (historyIndex < commandHistory.length - 1) {
        historyIndex++;
        terminalInput.value = commandHistory[historyIndex];
      } else {
        historyIndex = commandHistory.length;
        terminalInput.value = "";
      }
      e.preventDefault();
    }
  });

  // Focus input on click anywhere
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;

    // Check if clicking a navigation item or an ls item
    if (target.classList.contains("nav-item")) {
      const cmd = target.getAttribute("data-cmd");
      if (cmd) {
        terminalInput.value = cmd;
        handleCommand(cmd);
        terminalInput.value = "";
      }
    } else if (target.classList.contains("ls-item")) {
      const cmd = target.innerText.trim();
      if (cmd) {
        terminalInput.value = cmd;
        handleCommand(cmd);
        terminalInput.value = "";
      }
    }

    terminalInput.focus();
  });

  const inputRow = document.getElementById("current-input-row")!;
  const sleep = (ms: number) =>
    new Promise((resolve) => setTimeout(resolve, ms));

  async function startSequence() {
    inputRow.style.display = "none";

    createOutputBlock(
      'echo "Welcome to Deiver Pernia Portfolio."',
      "Welcome to Deiver Pernia Portfolio.",
    );
    await sleep(400);

    createOutputBlock(
      'echo "Type \\"help\\" to see all available commands."',
      'Type "help" to see all available commands.',
    );
    await sleep(400);

    handleCommand("name");
    await sleep(300);

    handleCommand("profession");
    await sleep(300);

    handleCommand("location");
    await sleep(300);

    handleCommand("ls");
    await sleep(400);

    inputRow.style.display = "block";
    terminalInput.focus();
    terminalWindow.scrollTop = terminalWindow.scrollHeight;
  }

  // Direct start sequence
  window.addEventListener("load", () => {
    startSequence();
  });
</script>

<style is:global>
  .text-white {
    color: var(--text-white);
  }
</style>
