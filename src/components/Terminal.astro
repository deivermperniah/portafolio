---
import CommandInput from "./CommandInput.astro";
---

<div class="terminal-window" id="terminal-window">
  <div id="terminal-output"></div>
  <div id="current-input-row" style="display: none;">
    <CommandInput />
  </div>
</div>

<script>
  import {
    profile,
    contact,
    stack,
    tools,
    experience,
    projects,
    education,
    languages,
    apps,
  } from "../data/profile";

  const terminalOutput = document.getElementById("terminal-output")!;
  const terminalWindow = document.getElementById("terminal-window")!;
  const terminalInput = document.getElementById("terminal-input") as HTMLInputElement;
  const inputRow = document.getElementById("current-input-row")!;
  const win = document.getElementById("win-terminal")!;

  const escapeHtml = (s: string) =>
    s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);

  const dim = (s: string) => `<i style="color: var(--text-gray); opacity: 0.8;">${s}</i>`;
  const link = (href: string, text: string) =>
    `<a href="${href}" target="_blank" rel="noopener" class="project-link">${text}</a>`;

  const openApp = (id: string) => document.dispatchEvent(new CustomEvent("os:open", { detail: id }));

  const SECTIONS = ["about", "contact", "languages", "skills", "tools", "experience", "projects", "education"];

  const DATA = {
    about: profile.about.join("\n\n"),
    skills: stack.map((g) => `${g.name}: ${g.items.join(" | ")}`).join("\n"),
    experience: experience
      .map(
        (job) =>
          `<span class="highlight">${job.role}</span> – ${job.company}\n${dim(job.period)}\n` +
          job.highlights.map((h) => `<span class="hanging-list">- ${h}</span>`).join(""),
      )
      .join("\n"),
    contact: [
      `Email:    <a href="mailto:${contact.email}" class="project-link">${contact.email}</a>`,
      `Teléfono: ${contact.phone} (${link(contact.whatsapp, "WhatsApp")})`,
      contact.linkedin && `LinkedIn: ${link(contact.linkedin, contact.linkedin)}`,
      contact.github && `GitHub:   ${link(contact.github, contact.github)}`,
    ]
      .filter(Boolean)
      .join("\n"),
    tools: tools.join(" | "),
    languages: languages.map((l) => `${l.name} - ${l.level}`).join("\n"),
    education: education
      .map((e) => `${e.title}\n${dim(e.period)}\n${e.institution}`)
      .join("\n\n"),
  };

  const HELP = `Comandos disponibles:
  help            - Muestra esta lista
  ls              - Lista las secciones del portafolio
  about           - Quién soy
  experience      - Experiencia profesional
  projects        - Proyectos en los que he trabajado
  skills          - Conocimientos técnicos
  tools           - Herramientas que uso a diario
  education       - Formación académica
  languages       - Idiomas
  contact         - Cómo contactarme
  cv              - Abre mi CV
  neofetch        - Información del "sistema"
  open &lt;app&gt;      - Abre una ventana (${apps.map((a) => a.id).join(", ")})
  whoami | name | profession | location
  clear           - Limpia la pantalla
  exit            - Cierra la terminal`;

  const NEOFETCH_LOGO = `  ____   ____
 |  _ \\ |  _ \\
 | | | || |_) |
 | |_| ||  __/
 |____/ |_|`;

  function neofetch() {
    const row = (k: string, v: string) => `<span class="highlight">${k}</span>: ${v}`;
    const info = [
      `<span class="highlight">${profile.user}</span>@<span class="highlight">portfolio</span>`,
      "-----------------------",
      row("OS", "Deiver OS 1.0 (Fedora edition)"),
      row("Rol", profile.role),
      row("Ubicación", profile.location),
      row("Uptime", "1 año de experiencia"),
      row("Kernel", "Ingeniería en Informática (en curso)"),
      row("Shell", "bash — portfolio edition"),
      row("Stack", stack.flatMap((g) => g.items).slice(0, 8).join(", ")),
      row("Idiomas", languages.map((l) => `${l.name} (${l.level})`).join(", ")),
      row("Estado", profile.available ? "🟢 Disponible para trabajar" : "Ocupado"),
    ].join("\n");
    const wrap = document.createElement("div");
    wrap.className = "neofetch";
    wrap.innerHTML = `<pre class="neofetch-logo">${NEOFETCH_LOGO}</pre><div>${info}</div>`;
    return wrap;
  }

  const commandHistory: string[] = [];
  let historyIndex = -1;

  function createOutputBlock(command: string, content: string | HTMLElement) {
    const block = document.createElement("div");
    block.className = "output-block";

    const promptLine = document.createElement("div");
    promptLine.className = "command-input-container";
    promptLine.innerHTML = `
      <span class="prompt">
        <span class="prompt-user">${profile.user}</span>@<span class="prompt-host">portfolio</span>:~$
      </span>
      <span style="color: var(--text-white);"></span>
    `;
    promptLine.lastElementChild!.textContent = command;

    const outputLine = document.createElement("div");
    outputLine.className = "command-output";

    if (typeof content === "string") {
      outputLine.innerHTML = content;
    } else {
      outputLine.appendChild(content);
    }

    block.appendChild(promptLine);
    block.appendChild(outputLine);
    terminalOutput.appendChild(block);
    terminalWindow.scrollTop = terminalWindow.scrollHeight;
  }

  function handleCommand(commandLine: string) {
    const fullCommand = commandLine.trim();
    if (!fullCommand) return;

    const [command, ...args] = fullCommand.toLowerCase().split(/\s+/);

    switch (command) {
      case "help":
        createOutputBlock(fullCommand, HELP);
        break;

      case "about":
      case "skills":
      case "experience":
      case "contact":
      case "tools":
      case "languages":
      case "education":
        createOutputBlock(fullCommand, DATA[command as keyof typeof DATA]);
        break;

      case "projects": {
        const list = document.createElement("div");
        projects.forEach((p) => {
          const item = document.createElement("div");
          item.style.marginBottom = "4px";
          const links = [
            p.demo && link(p.demo, "demo"),
            p.repo && link(p.repo, "código"),
            `<a href="#" class="project-link" data-term-project="${p.slug}">detalles</a>`,
          ]
            .filter(Boolean)
            .join(" | ");
          item.innerHTML = `- <span style="display:inline-block; min-width: 150px; color: var(--text-white);">${p.name}</span> ${p.summary} ${dim(`[${links}]`)}`;
          list.appendChild(item);
        });
        createOutputBlock(fullCommand, list);
        break;
      }

      case "ls": {
        const lsOutput = document.createElement("div");
        lsOutput.className = "ls-grid";
        lsOutput.innerHTML = SECTIONS.map(
          (s) => `<button class="ls-item" data-term-cmd="${s}">${s}/</button>`,
        ).join("");
        createOutputBlock(fullCommand, lsOutput);
        break;
      }

      case "neofetch":
        createOutputBlock(fullCommand, neofetch());
        break;

      case "cv":
        createOutputBlock(fullCommand, "Abriendo CV.pdf…");
        openApp("cv");
        break;

      case "linkedin":
      case "github": {
        const url = contact[command];
        if (url) {
          createOutputBlock(fullCommand, `Abriendo ${link(url, url)}…`);
          window.open(url, "_blank", "noopener");
        } else {
          createOutputBlock(fullCommand, `${command}: perfil no configurado todavía.`);
        }
        break;
      }

      case "open": {
        const target = args[0];
        const app = apps.find((a) => a.id === target || a.title.toLowerCase() === target);
        if (app) {
          createOutputBlock(fullCommand, `Abriendo ${app.file}…`);
          openApp(app.id);
        } else {
          createOutputBlock(
            fullCommand,
            `open: '${escapeHtml(target ?? "")}' no existe. Apps: ${apps.map((a) => a.id).join(", ")}`,
          );
        }
        break;
      }

      case "sudo":
        if (args.join(" ") === "hire-me" || args.join(" ") === "hire deiver") {
          createOutputBlock(
            fullCommand,
            `[sudo] contraseña para reclutador: ********\n<span class="highlight">✔ Permiso concedido.</span> Excelente decisión. Abriendo contacto…`,
          );
          setTimeout(() => openApp("contact"), 700);
        } else {
          createOutputBlock(
            fullCommand,
            `${profile.user} no está en el archivo sudoers. Este incidente será reportado. 😉\nPrueba: sudo hire-me`,
          );
        }
        break;

      case "whoami":
        createOutputBlock(fullCommand, `${profile.name} — ${profile.headline}`);
        break;

      case "name":
        createOutputBlock(fullCommand, profile.name);
        break;

      case "profession":
        createOutputBlock(fullCommand, profile.role);
        break;

      case "location":
        createOutputBlock(fullCommand, profile.location);
        break;

      case "date":
        createOutputBlock(fullCommand, new Date().toLocaleString("es"));
        break;

      case "echo":
        createOutputBlock(fullCommand, escapeHtml(commandLine.trim().slice(5)));
        break;

      case "clear":
        terminalOutput.innerHTML = "";
        break;

      case "exit":
        document.dispatchEvent(new CustomEvent("os:close", { detail: "terminal" }));
        break;

      default:
        createOutputBlock(
          fullCommand,
          `bash: ${escapeHtml(command)}: orden no encontrada. Escribe <span class="highlight">help</span> para ver los comandos.`,
        );
    }
  }

  terminalInput.addEventListener("keydown", (e) => {
    if (e.key === "Enter") {
      const command = terminalInput.value;
      if (command.trim()) {
        commandHistory.push(command);
        historyIndex = commandHistory.length;
      }
      handleCommand(command);
      terminalInput.value = "";
    } else if (e.key === "ArrowUp") {
      if (historyIndex > 0) {
        historyIndex--;
        terminalInput.value = commandHistory[historyIndex];
      }
      e.preventDefault();
    } else if (e.key === "ArrowDown") {
      if (historyIndex < commandHistory.length - 1) {
        historyIndex++;
        terminalInput.value = commandHistory[historyIndex];
      } else {
        historyIndex = commandHistory.length;
        terminalInput.value = "";
      }
      e.preventDefault();
    } else if (e.key === "Tab") {
      // Autocompletado simple de comandos
      e.preventDefault();
      const known = [...SECTIONS, "help", "ls", "cv", "neofetch", "open", "whoami", "clear", "exit", "linkedin", "github"];
      const match = known.find((c) => c.startsWith(terminalInput.value.trim().toLowerCase()));
      if (match && terminalInput.value.trim()) terminalInput.value = match;
    }
  });

  terminalWindow.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const cmd = target.closest<HTMLElement>("[data-term-cmd]")?.dataset.termCmd;
    const project = target.closest<HTMLElement>("[data-term-project]")?.dataset.termProject;

    if (cmd) handleCommand(cmd);
    if (project) {
      e.preventDefault();
      openApp("projects");
      document.dispatchEvent(new CustomEvent("os:project", { detail: project }));
      return;
    }
    // No robar el foco si el usuario está seleccionando texto
    if (!window.getSelection()?.toString()) terminalInput.focus();
  });

  const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
  let started = false;

  async function startSequence() {
    started = true;
    createOutputBlock("neofetch", neofetch());
    await sleep(300);
    createOutputBlock(
      'echo "Escribe help para ver los comandos"',
      'Escribe <span class="highlight">help</span> para ver los comandos, o prueba <span class="highlight">sudo hire-me</span>.',
    );
    await sleep(300);
    handleCommand("ls");
    inputRow.style.display = "block";
    terminalInput.focus();
  }

  win.addEventListener("app:focus", () => {
    if (!started) startSequence();
    else terminalInput.focus({ preventScroll: true });
  });
</script>
