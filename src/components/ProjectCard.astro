---
interface Props {
  id: string;
  title: string;
  description: string;
  tech: string[];
}

const { id, title, description, tech } = Astro.props;
---

<div class="project-card">
  <h3>[{id}] {title}</h3>
  <p>{description}</p>
  <p class="dim">Tech: {tech.join(", ")}</p>
  <p class="highlight">Use 'open {id}' to view</p>
</div>
